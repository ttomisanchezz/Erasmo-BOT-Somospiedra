# Copiar este archivo como .env y completar.

PORT=3001

# --- Evolution API (corre en Docker en esta misma PC) ---
EVOLUTION_URL=http://localhost:8080
EVOLUTION_INSTANCE=somosiphone
# Tiene que ser la misma clave que AUTHENTICATION_API_KEY del docker-compose
EVOLUTION_APIKEY=cambiar-esta-clave-por-una-larga

# --- Webhook: lo que llama Evolution cada vez que llega un mensaje ---
# Secreto en la ruta. Con valor, el bot solo acepta POST /webhook/<secreto> y le
# responde 401 a todo lo demas. Tiene que ser el mismo que va al final de
# WEBHOOK_GLOBAL_URL en docker-compose.yml (se carga desde .env.docker).
# Solo letras y numeros. Para generar uno:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Vacio: acepta /webhook como siempre y lo avisa al arrancar. Ver README.
WEBHOOK_SECRETO=
# Tope de pedidos por minuto que acepta el webhook (por defecto 600).
# WEBHOOK_MAX_POR_MINUTO=600

# Direccion donde escucha el bot. Vacio (lo normal): todas las interfaces.
# HOST=127.0.0.1 lo deja solo en esta PC, pero hay que probar que Evolution,
# desde Docker, siga llegando (ver README).
HOST=

# --- Gemini (tier gratuito, sin tarjeta: aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Decision del 30/09/2026 (precios por millon de tokens, entrada / salida, y baja segun Google):
#   gemini-3.5-flash-lite  US$0,30 / US$2,50   sin fecha de baja        <- principal
#   gemini-3.1-flash-lite  US$0,25 / US$1,50   baja el 07/05/2027       <- respaldo
#   gemini-2.5-flash-lite  Google lo limita a quienes ya lo usaban: no usarlo
GEMINI_MODEL=gemini-3.5-flash-lite
# Respaldo: otro modelo con su propio cupo. Se pasa a el si el principal esta saturado,
# no responde, no existe (404) o se quedo sin cupo del dia (429 por dia). Tiene que
# existir en la lista de modelos de la API.
GEMINI_MODEL_RESPALDO=gemini-3.1-flash-lite

# --- Cerebro Sonnet (01/10/2026): Claude Sonnet 5.5 decide que contestar ---
# Con sombra, con cada tanda real Sonnet piensa que contestaria y queda anotado
# en data/aprendizaje-v2.jsonl (eventos propuesta-sonnet), pero NO SE MANDA NADA: el
# cliente y el grupo reciben lo mismo que siempre. Ver src/cerebro.js y CLAUDE.md.
# Clave: platform.claude.com (API keys). El tope de gasto (USD 60 por mes) se pone en
# la cuenta de Anthropic, no aca.
ANTHROPIC_API_KEY=
# apagado (lo normal: nunca llama a la API) | sombra
# Fase 2 (02/10/2026), Sonnet CONTESTA DE VERDAD:
#   tester = al celular de NUMEROS_TESTER; al resto, el bot y Sonnet en sombra
#   nuevos = al tester y a los chats nuevos (quedan marcados: siguen con Sonnet aunque
#            cambies el modo, hasta #reset o #bot <numero>); al resto, el bot y la sombra
#   todos  = a todos los que contesta el bot
# Solo apagado corta a todos. Cambiarlo pide reiniciar el bot.
CEREBRO_MODO=apagado
# CEREBRO_MODELO=claude-sonnet-5-5
# Cada pedido a la API, en milisegundos. Si tarda mas, ese turno queda como error.
# CEREBRO_TIMEOUT_MS=20000
# Cuanto piensa: low, medium (por defecto) o high. low es mas barato y mas rapido.
# CEREBRO_ESFUERZO=medium
# Precios en USD por millon de tokens, solo para estimar el gasto (/salud y el registro).
# Los de Sonnet 5.5 al 02/10/2026:
# CEREBRO_USD_ENTRADA=2
# CEREBRO_USD_SALIDA=10
# CEREBRO_USD_CACHE_LEIDA=0.20
# CEREBRO_USD_CACHE_ESCRITA=2.50
# Sombra donde atiende una persona (03/10/2026, decision de Tomas, por 7 dias): hasta ese
# dia (AAAA-MM-DD, hora de Argentina) Sonnet tambien piensa en los chats que atiende una
# persona (los 45 min despues de que escribio alguien de la cuenta, #pausa) y en los
# escalados que callan. NO MANDA NADA: queda en data/aprendizaje-v2.jsonl como
# propuesta-sonnet con conPersona, para compararlo con lo que contestaron. Vacia: nada.
# Tope por dia en USD (en memoria). Cambiarlo pide reiniciar el bot.
# CEREBRO_SOMBRA_PERSONA_HASTA=2026-10-10
# CEREBRO_SOMBRA_PERSONA_TOPE_USD=1.5
# El tope de gasto de Sonnet del mes en USD (bloque Ninjo 2): lo muestran /salud y el
# panel, y al pasar el 80% sale un aviso al grupo. No corta nada: el tope de verdad esta
# en la cuenta de Anthropic. Es uno solo desde el 08/10/2026: si no esta, vale
# CHIARA_TOPE_MES_USD (la del panel, la de antes); si tampoco, 60.
CEREBRO_TOPE_MES_USD=60

# --- Planilla Cotizador ---
SHEET_ID=1EDH2ESB9S9OfHjtgHPWsnoJftsxCVMM4QVmdSAydhGE
GOOGLE_CREDENTIALS_PATH=./credenciales.json
SHEET_CACHE_SEGUNDOS=300

# --- Grupo interno de avisos (Tomi + Fran) ---
# OJO: aca van los avisos y el resumen, que llevan nombres, modelos y
# presupuestos de OTROS clientes. Si te equivocas de numero, esos datos le
# llegan a un tercero. El bot tiene una guardia que lo frena, pero igual
# verifica con:  npm run destino
#
# Lo ideal es un GRUPO (termina en @g.us). Un numero personal tambien sirve:
# 54 + 9 + codigo de area sin el 0 + numero sin el 15, y @s.whatsapp.net
# Ejemplo de formato (NO es un numero real): 5490000000000@s.whatsapp.net
GRUPO_AVISOS_JID=

# --- Ritmo humano (protege el numero de un baneo) ---
ESPERA_MIN_MS=20000
ESPERA_MAX_MS=45000
ENTRE_MENSAJES_MS=1800
MAX_MENSAJES_TANDA=4
SILENCIO_TRAS_HUMANO_MIN=45
# Cuando vence ese silencio (bloque Ninjo 1b): una linea del cliente que llego con la
# persona atendiendo y nadie contesto la atiende Sonnet, si tiene menos de
# SILENCIO_MAX_HORAS, hasta SILENCIO_MAX_POR_BARRIDO chats por vuelta (cada 1 minuto).
# SILENCIO_MAX_HORAS=72
# SILENCIO_MAX_POR_BARRIDO=3

# Ignora los mensajes mas viejos que esto (segundos). Evita que la
# sincronizacion de historial al vincular el QR queme la cuota de Gemini.
IGNORAR_ANTERIORES_SEG=120

# --- Chat escalado: el bot se calla hasta que alguien lo tome ---
# Un solo recordatorio al grupo si el cliente escribio algo despues de escalar y
# nadie de la cuenta le escribio en estos minutos. De noche no suena: usa la franja
# de los recordatorios (RECORDATORIO_HORA a SEGUIMIENTO_HORA_HASTA); si se cumple
# fuera de ella, sale a la manana.
ESCALADO_RECORDATORIO_MIN=30
# Pasadas estas horas sin que nadie lo tome, un mensaje nuevo del cliente se
# atiende como consulta nueva.
ESCALADO_REANUDAR_HORAS=24

# --- Datos viejos: cualquier chat que vuelve despues de mucho ---
# Si un cliente escribe pasadas estas horas sin actividad en el chat (el ultimo
# mensaje de cualquiera de los dos), se lo atiende como consulta nueva, haya
# escalado o no: se borran el modelo, el monto, la forma de pago, la permuta y
# las marcas de "esto ya se dijo" de la charla vieja. Quedan el nombre, la zona,
# las notas, el historial y lo que ya se le explico. 72 = tres dias.
DATOS_VIEJOS_HORAS=72

# --- Guardian de Evolution: avisa al grupo cuando dejan de llegar los mensajes ---
# Solo le escribe al grupo interno (necesita GRUPO_AVISOS_JID), nunca a un
# cliente, y no reinicia nada. En MODO_ESCUCHA no sale ningun aviso: el corte
# queda en la consola y en /salud. Avisa una vez por corte y otra cuando vuelve:
#   - si la instancia de Evolution no dice "open" (o Evolution no responde);
#   - si dice "open" pero no llega NINGUN mensaje en GUARDIAN_SIN_MENSAJES_MIN
#     minutos, solo entre SEGUIMIENTO_HORA_DESDE y SEGUIMIENTO_HORA_HASTA (de
#     madrugada no llegan mensajes y eso no es una falla).
# false apaga los dos controles.
GUARDIAN_ACTIVO=true
# Cada cuantos minutos mira.
GUARDIAN_MIN=5
# Si en una tarde tranquila avisa de mas, subilo; para enterarte antes, bajalo.
GUARDIAN_SIN_MENSAJES_MIN=45

# --- Resumen de la manana al grupo interno ---
# Llega solo a esta hora con lo que hay que contestar hoy, ordenado por
# cuan cerca esta cada cliente de comprar. Necesita GRUPO_AVISOS_JID.
# Arranca en false. Encendelo recien despues de correr `npm run destino`
# y confirmar que el destino es el correcto.
RESUMEN_ACTIVO=false
RESUMEN_HORA=9
RESUMEN_DIAS_FRIO=3

# --- Recordatorios manuales al grupo interno ---
# En el chat del cliente, desde la cuenta del negocio:
#   #recordar <que hay que hacer>   lo recuerda cada hora en el grupo
#   #hecho                          deja de recordarlo
# OJO: el cliente ve lo que escribis en su chat.
#
# Suena a la hora en punto desde RECORDATORIO_HORA hasta antes de
# SEGUIMIENTO_HORA_HASTA. El arranque no depende de SEGUIMIENTO_HORA_DESDE:
# esto va al grupo interno, no a clientes. En MODO_ESCUCHA se guardan pero no
# suenan. Despues de RECORDATORIO_MAX_REPETICIONES avisos sin #hecho, avisa
# una vez y deja de repetir.
RECORDATORIO_HORA=8
RECORDATORIO_MAX_REPETICIONES=10

# --- Fotos de los equipos (13.jpg, 14-pro.jpg, 15-pro-max.png...) ---
# Las sueltas por modelo son las de referencia de #sinstock. Desde el 08/10/2026, con
# STOCK_APP_MODO=vivo, Chiara manda ademas las fotos de los equipos del local: una
# subcarpeta por modelo (fotos/iPhone 15/) y el indice fotos/indice.json que escribe Claude
# (ver CLAUDE.md, "Chiara manda fotos de los equipos del local"). Sin el indice, sin fotos.
FOTOS_DIR=./fotos

# --- Seguimiento (bloque Ninjo 1b, 05/10/2026) ---
# Sale solo despues de una tanda del bot con un precio de contado o una cotizacion que
# le llego, si el cliente no contesto y ninguna persona de la cuenta escribio despues.
# Hasta 2: el 1o, SEGUIMIENTO_HORAS_1 despues del precio, dentro de la franja (hora de
# Argentina); el 2o, el dia siguiente entre SEGUIMIENTO_FRANJA_DESDE y
# SEGUIMIENTO_MANANA_HASTA. SEGUIMIENTO_MINUTOS ya no se usa.
SEGUIMIENTO_ACTIVO=true
SEGUIMIENTO_MINUTOS=45
# SEGUIMIENTO_HORAS_1=3
# SEGUIMIENTO_FRANJA_DESDE=10
# SEGUIMIENTO_FRANJA_HASTA=21
# SEGUIMIENTO_MANANA_HASTA=12
# Ya no son del seguimiento: cierran los recordatorios y son la franja del guardian.
SEGUIMIENTO_HORA_DESDE=9
SEGUIMIENTO_HORA_HASTA=22

# MODO ESCUCHA: el bot NO manda ningun mensaje, ni al cliente ni al grupo.
# Solo lee las conversaciones reales y aprende de como contestan ustedes.
# Es el modo mas seguro para arrancar.
MODO_ESCUCHA=true

# ARRANCA EN TRUE. En true el bot NO le escribe a los clientes:
# manda al grupo interno lo que habria contestado.
MODO_BORRADOR=true

# CONTACTOS PERSONALES. Familia, amigos, proveedores: gente que escribe al
# mismo numero que los clientes pero no es una venta.
#
# Un chat de esta lista se ignora ENTERO: no se procesa, no se guarda en
# estado.json, no va a Gemini, no se le transcriben los audios, no sale en el
# resumen y NUNCA se le contesta. El corte es lo primero que hace el bot.
#
# VACIA (lo normal) no cambia nada. Separar con comas, con o sin el 9.
#   CONTACTOS_PERSONALES=5492995550001,5492995550002
#
# Al arrancar, el bot dice cuantos tiene cargados.
CONTACTOS_PERSONALES=

# NOTAS DE VOZ. El bot transcribe los audios con Gemini: los tuyos (para que
# entren al aprendizaje, que es la mejor muestra de como venden) y los de los
# clientes (que se procesan como texto solo si la transcripcion es clara).
# Si un audio no se entiende, el bot NUNCA cotiza: pide que lo escriban y escala.
#
# El archivo no viene en el webhook: se le pide a Evolution por su API, asi que
# no hay que tocar docker-compose ni reconectar el numero.
#
# Ponelo en false para apagar solo esto, sin tocar el resto del bot.
# Con `npm run evaluar -- --offline` tampoco transcribe, pase lo que pase.
AUDIO_ACTIVO=true

# LISTAS BLANCAS DE PRUEBA. Para probar en vivo de forma controlada.
#
# Las dos VACIAS (lo normal): no cambia NADA del comportamiento.
#
# Con contenido en alguna: el bot SOLO le puede escribir a esos numeros. A
# cualquier otro lo trata como si MODO_BORRADOR siguiera en true, o sea que el
# cliente no recibe nada y el borrador igual llega al grupo interno. Cubre los
# cinco caminos: texto, foto, PDF, el texto de respaldo del PDF y el seguimiento.
# El grupo de avisos nunca se filtra.
#
# TESTER: tu celular de prueba. Ademas de recibir los envios, desde ese chat
# podes mandar #reset (o #resset, #reseet, #rest) para dejar el chat como nuevo;
# cualquier otro mensaje que empiece con # se descarta. Sus leads van a la
# pestana LEADS_PRUEBA y no sale en el resumen de la manana.
#
# PILOTO: clientes reales de la prueba. Reciben los envios como el tester, pero
# para todo lo demas son clientes: "#reset" es un mensaje comun, el lead va a
# LEADS y aparecen en el resumen.
#
# Separar con comas. Se ignora todo lo que no sea digito, y da igual si
# escribis el numero con o sin el 9 de celular.
#   NUMEROS_TESTER=5492995551234
#   NUMEROS_PILOTO=5492995551235,54 299 555-1236
# NUMEROS_PILOTO=todos pone el bot en vivo para cualquier cliente y deja el
# tester aparte (comandos #, LEADS_PRUEBA, fuera del resumen).
#
# Al arrancar, el bot avisa bien grande si estan activas. No las dejes puestas.
# NUMEROS_PRUEBA es el nombre viejo de NUMEROS_TESTER: si NUMEROS_TESTER esta
# vacia y NUMEROS_PRUEBA tiene contenido, se lee esa y el bot avisa al arrancar.
NUMEROS_TESTER=
NUMEROS_PILOTO=

# PRECIOS DE TECHSUR (01/10/2026). El bot lee el grupo Avisos de la comunidad
# TechSur (el proveedor) y guarda cada equipo con precio en la app de ventas,
# que los muestra en el panel Cotizacion. Solo lee: nunca le escribe al grupo,
# no pasa por Gemini y no toca a ningun cliente. Ver src/techsur.js.
#
# El grupo se busca por nombre (TECHSUR_GRUPO_NOMBRE, "techsur" por defecto).
# Cuando lo encuentra lo dice en consola: "[techsur] grupo encontrado: ...".
# Para fijarlo, o si el nombre no coincide, poné su JID en TECHSUR_GRUPO_JID
# (los JID de todos los grupos: npm run techsur -- --grupos).
#
# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY son los del Supabase de la app de
# ventas: los mismos valores que su .env.local. Sin ellos el bot sigue igual y
# solo avisa en consola que no guarda los precios.
#
# TECHSUR_ACTIVO=false lo apaga sin tocar el resto del bot.
TECHSUR_ACTIVO=true
TECHSUR_GRUPO_NOMBRE=techsur
TECHSUR_GRUPO_JID=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- PANEL CHIARA (06/10/2026) ---
# Cada 1 minuto el bot sube al Supabase de la app de ventas (SUPABASE_URL y
# SUPABASE_SERVICE_ROLE_KEY, los mismos de arriba) su estado, los leads, los
# numeros del dia y las noticias, y lee las ordenes del panel (pausar, devolver,
# apagar, prender, vendido, perdido). Lo propio queda en data/chiara.json y el
# interruptor general en data/interruptor.json. Ver src/panel-chiara.js.
#
# CHIARA_PANEL_ACTIVO=false lo apaga entero: no cuenta ni sube nada (el
# interruptor sigue valiendo como quedo guardado).
# El gasto de Sonnet del mes que muestra el panel es el mismo de /salud, con su
# tope (CEREBRO_TOPE_MES_USD, mas arriba, 08/10/2026): CHIARA_TOPE_MES_USD ya no
# hace falta.
CHIARA_PANEL_ACTIVO=true

# --- EL STOCK DE LA APP EN LA PLANILLA (08/10/2026) ---
# La planilla del Cotizador es donde vive todo: la app la cambia por medio del bot
# y Chiara la sigue leyendo. Cada 1 minuto el bot lee v_stock_chiara del Supabase
# de la app (SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY de arriba; necesita la
# migracion 0018) y escribe lo del local en la pestaña USADOS; aplica los pedidos
# de la app (planilla_ordenes: SI/NO en la columna STOCK de LISTA y LISTA 85-93,
# lo del deposito) y el espejo copia STOCK a la app. Ver src/stock-app.js.
#   apagado = nada de esto corre; Chiara contesta como siempre (lo normal).
#   sombra  = escribe la pestaña "USADOS APP" (la crea si falta) para compararla
#             en el Drive, aplica las ordenes y copia STOCK; Chiara contesta como
#             siempre (sin el filtro de STOCK ni la frase del deposito).
#   vivo    = escribe USADOS y Chiara usa lo nuevo: local primero, el deposito con
#             STOCK, la frase del deposito ("te lo tengo mañana" / "el lunes") y el
#             codigo del equipo al escalar.
# Antes de vivo: la columna STOCK en LISTA y LISTA 85-93 (en la fila de los
# encabezados, hasta la columna Z). Cambiarlo pide reiniciar el bot.
STOCK_APP_MODO=apagado
