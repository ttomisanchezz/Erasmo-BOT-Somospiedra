# Bot de WhatsApp de Somos Piedra. Copiar este archivo como .env y completar.
# Va siempre con los valores vacios: los reales van solo en el .env (que no se sube).

# Puerto del webhook. El 3001 es el del bot de Somos iPhone (misma PC).
PORT=3002

# --- Evolution API (Docker, COMPARTIDO con Somos iPhone: una instancia por negocio) ---
EVOLUTION_URL=http://localhost:8080
# La instancia de Piedra (por ejemplo somospiedra). OBLIGATORIA: vacia o "somosiphone",
# el bot NO arranca (se negaria a leer y contestar el WhatsApp de iPhone).
EVOLUTION_INSTANCE=
# La misma clave que AUTHENTICATION_API_KEY de Evolution.
EVOLUTION_APIKEY=

# --- Webhook: lo que llama Evolution cada vez que llega un mensaje ---
# Secreto en la ruta. Con valor, el bot solo acepta POST /webhook/<secreto> y le
# responde 401 a todo lo demas. Solo letras y numeros. Para generar uno:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Vacio: acepta /webhook como siempre y lo avisa al arrancar.
WEBHOOK_SECRETO=
# Tope de pedidos por minuto que acepta el webhook (por defecto 600).
# WEBHOOK_MAX_POR_MINUTO=600

# Direccion donde escucha el bot. Vacio (lo normal): todas las interfaces.
HOST=

# --- Gemini: SOLO para transcribir audios ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Respaldo: otro modelo con su propio cupo (saturado, sin respuesta, 404 o sin cupo del dia).
GEMINI_MODEL_RESPALDO=gemini-3.1-flash-lite

# --- Cerebro Sonnet: el UNICO que contesta (no hay "bot de siempre") ---
ANTHROPIC_API_KEY=
# apagado = nadie contesta: el bot solo escucha, guarda y registra (lo normal hasta
#           que Tomas diga "prende pilotos" / "prende para todos")
# sombra  = Sonnet piensa con cada tanda y se anota en el registro, sin mandar nada
# tester  = Sonnet le contesta SOLO al celular de NUMEROS_TESTER; el resto: nadie (escucha y guarda, sin llamar a la API)
# nuevos  = al tester y a los chats nuevos (quedan marcados hasta #reset o #bot)
# todos   = a todos
# Si Sonnet falla (error, timeout, sin clave): silencio con el cliente y aviso al grupo.
CEREBRO_MODO=apagado
# CEREBRO_MODELO=claude-sonnet-5-5
# CEREBRO_TIMEOUT_MS=20000
# CEREBRO_ESFUERZO=medium
# Precios en USD por millon de tokens, solo para estimar el gasto (/salud y el registro).
# CEREBRO_USD_ENTRADA=2
# CEREBRO_USD_SALIDA=10
# CEREBRO_USD_CACHE_LEIDA=0.20
# CEREBRO_USD_CACHE_ESCRITA=2.50
# Sombra donde atiende una persona: hasta ese dia (AAAA-MM-DD) Sonnet tambien piensa, sin
# mandar nada, en los chats que atiende una persona y en los escalados. Vacia: nada.
# CEREBRO_SOMBRA_PERSONA_HASTA=
# CEREBRO_SOMBRA_PERSONA_TOPE_USD=1.5
# Tope de gasto del mes (solo para /salud y el aviso del 80%; el de verdad va en Anthropic).
CEREBRO_TOPE_MES_USD=60

# --- Grupo interno de avisos (tiene que ser un grupo: termina en @g.us) ---
# El id del grupo "Bot Erasmo" sale de: npm run grupos
GRUPO_AVISOS_JID=
# Los avisos al grupo salen de esta hora a esta hora (Argentina). Los de afuera se juntan y salen juntos a la de desde.
# AVISOS_HORA_DESDE=9
# AVISOS_HORA_HASTA=20

# --- Precios del panel (Supabase): el usuario propio de Erasmo (rol bot, solo lectura) ---
# Sin estas cuatro, no hay precios: todo es FALTA DATO y Erasmo escala.
SUPABASE_URL=
SUPABASE_ANON_KEY=
ERASMO_EMAIL=
ERASMO_PASSWORD=
# Donde queda la ultima copia buena de los precios (vacio: data/precios/panel-cache.json).
# PRECIOS_CACHE_PATH=

# --- Ritmo humano ---
ESPERA_MIN_MS=20000
ESPERA_MAX_MS=45000
ENTRE_MENSAJES_MS=1800
MAX_MENSAJES_TANDA=4

# Si contesto una persona de la cuenta, el bot se calla este rato (minutos).
SILENCIO_TRAS_HUMANO_MIN=45
# Cuando vence ese silencio, lo que el cliente dejo sin contestar lo atiende Sonnet
# (si tiene menos de SILENCIO_MAX_HORAS), hasta SILENCIO_MAX_POR_BARRIDO chats por vuelta.
# SILENCIO_MAX_HORAS=72
# SILENCIO_MAX_POR_BARRIDO=3

# Ignora los mensajes mas viejos que esto (segundos): la sincronizacion al vincular el QR.
IGNORAR_ANTERIORES_SEG=120

# --- Chat escalado: el bot se calla hasta que alguien lo tome ---
ESCALADO_RECORDATORIO_MIN=30
ESCALADO_REANUDAR_HORAS=24

# --- Datos viejos: un chat que vuelve despues de tantas horas es una consulta nueva ---
DATOS_VIEJOS_HORAS=72

# --- Guardian de Evolution: avisa al grupo cuando dejan de llegar los mensajes ---
GUARDIAN_ACTIVO=true
GUARDIAN_MIN=5
GUARDIAN_SIN_MENSAJES_MIN=45

# --- Recordatorios manuales (#recordar / #hecho) ---
RECORDATORIO_HORA=8
RECORDATORIO_MAX_REPETICIONES=10

# Franja del guardian; HASTA cierra tambien los recordatorios.
SEGUIMIENTO_HORA_DESDE=9
SEGUIMIENTO_HORA_HASTA=22

# MODO ESCUCHA: no manda ningun mensaje, ni al cliente ni al grupo. El mas seguro.
MODO_ESCUCHA=true
# MODO BORRADOR: no le escribe a los clientes; manda al grupo lo que habria contestado.
MODO_BORRADOR=true

# Contactos personales (familia, amigos, proveedores): se ignoran enteros.
# Separar con comas, con o sin el 9.
CONTACTOS_PERSONALES=

# Notas de voz (Gemini). false apaga solo esto.
AUDIO_ACTIVO=true

# Listas blancas de prueba. Con contenido en alguna, el bot SOLO le escribe a esos
# numeros; al resto lo trata como borrador. NUMEROS_PILOTO=todos: en vivo para todos.
# El tester ademas puede mandar #reset desde su chat.
NUMEROS_TESTER=
NUMEROS_PILOTO=

# Solo chats nuevos (necesita la semilla: npm run sembrar-viejos con el bot frenado).
SOLO_CHATS_NUEVOS=

# Carpeta de los archivos que genera el bot (imagen del simulador, presupuesto en PDF).
# Vacia: data/generados. Solo de ahi se mandan, al chat para el que se generaron y por 24 h.
GENERADOS_DIR=

# Reactivacion de Piedra (2 mensajes por chat, escritos por el codigo). Todo vacio = apagada.
# ERASMO_REACTIVACION_ACTIVA=true la prende. Tope por dia 40, mensaje 1 a los 2 dias, mensaje 2 a los 7 dias
# del 1, solo chats con actividad del cliente en los ultimos 30 dias (los valores de abajo son los de siempre).
ERASMO_REACTIVACION_ACTIVA=
ERASMO_REACTIVACION_TOPE_DIA=
ERASMO_REACTIVACION_DIAS_1=
ERASMO_REACTIVACION_DIAS_2=
ERASMO_REACTIVACION_VENTANA_DIAS=

# Carpetas de las propuestas de #tanda y de #reactivar-prueba. Vacias: data/tandas y data/reactivacion.
TANDAS_DIR=
REACTIVACION_DIR=
